<ui:FluentWindow x:Class="LocalAsrClient.App.ContinuousDictation.ContinuousDictationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:infra="clr-namespace:LocalAsrClient.App.Infrastructure"
        Title="连续听写"
        Topmost="True"
        ShowInTaskbar="True"
        ShowActivated="True"
        Width="560"
        Height="680"
        MinWidth="430"
        MinHeight="440"
        Background="{StaticResource LessAsr.Brush.AppBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="连续听写" Padding="12,0,0,0"/>

        <Border Grid.Row="1" Style="{StaticResource LessAsr.Card}" Margin="12,4,12,10" Padding="16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource LessAsr.Text.SectionTitle}"/>
                    <TextBlock Text="按右 Ctrl 分段，按 F9 结束本轮录音。" Style="{StaticResource LessAsr.Text.Caption}" Margin="0,5,0,0"/>
                    <TextBlock Text="演示模式 · 内容为固定示例数据"
                               Foreground="{StaticResource LessAsr.Brush.Accent}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Visibility="{Binding IsDemoMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <Border Style="{StaticResource LessAsr.StatusBadge}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource LessAsr.Brush.Accent}" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding RecordingStatusText}" Foreground="{StaticResource LessAsr.Brush.Accent}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource LessAsr.Brush.WarningSoft}"
                BorderBrush="{StaticResource LessAsr.Brush.Warning}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="12,0,12,10"
                Visibility="{Binding HasBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding BannerMessage}" Foreground="{StaticResource LessAsr.Brush.Warning}" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="3"
                      x:Name="SegmentScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Padding="12,0,8,0">
            <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Top">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="VerticalAlignment" Value="Top"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,4,10" Padding="14" CornerRadius="14" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource LessAsr.Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Error}"/>
                                            <Setter Property="Background" Value="{StaticResource LessAsr.Brush.ErrorSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="听写分段" Style="{StaticResource LessAsr.Text.Caption}" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource LessAsr.Brush.AccentSoft}" CornerRadius="9" Padding="8,3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource LessAsr.Brush.Accent}" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LessAsr.TextBox}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalAlignment="Top"
                                             VerticalScrollBarVisibility="Disabled"
                                             VerticalContentAlignment="Top"
                                             MinHeight="44"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             infra:AutoGrowTextBox.Enable="True"
                                             infra:ScrollViewerWheelForwarder.Enable="True"
                                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"/>
                                    <TextBlock Text="{Binding Placeholder}"
                                               Style="{StaticResource LessAsr.Text.Secondary}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding ShowPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Style="{StaticResource LessAsr.Card}" Margin="12,10,12,12" Padding="12">
            <Grid>
                <Button Content="关闭" Command="{Binding CloseCommand}" Style="{StaticResource LessAsr.SecondaryButton}" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="复制全部" Command="{Binding CopyCommand}" Style="{StaticResource LessAsr.SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="结束录制" Command="{Binding EndRecordingCommand}" Style="{StaticResource LessAsr.PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
