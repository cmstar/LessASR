<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Brand\LessASR.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalAsrClient.Core\LocalAsrClient.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Brand\*.ico" />
    <None Remove="Assets\Brand\LessASR.Brand.png" />
    <Resource Include="Assets\Brand\LessASR.ico" />
    <Resource Include="Assets\Brand\LessASR.Brand.png" />
    <EmbeddedResource Include="Assets\Brand\LessASR.Tray.Dark.ico"
                      LogicalName="LocalAsrClient.App.Assets.Brand.LessASR.Tray.Dark.ico" />
    <EmbeddedResource Include="Assets\Brand\LessASR.Tray.Light.ico"
                      LogicalName="LocalAsrClient.App.Assets.Brand.LessASR.Tray.Light.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
</Project>
