<ContextMenu x:Class="LocalAsrClient.App.Tray.TrayContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="140"
             Padding="0"
             Placement="MousePoint"
             StaysOpen="False"
             FocusVisualStyle="{x:Null}">
    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <Grid Margin="5">
                <Border Padding="4"
                        Background="{StaticResource LessAsr.Brush.CardBackground}"
                        BorderBrush="{StaticResource LessAsr.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          Direction="270"
                                          Opacity="0.2"
                                          ShadowDepth="2"
                                          Color="#000000"/>
                    </Border.Effect>
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
            </Grid>
        </ControlTemplate>
    </ContextMenu.Template>

    <ContextMenu.Resources>
        <Style TargetType="MenuItem"
               BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource LessAsr.Brush.TextPrimary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Background" Value="{StaticResource LessAsr.Brush.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContextMenu.Resources>

    <MenuItem Header="显示主窗口"
              Click="OnOpenWindowClick"
              AutomationProperties.Name="显示主窗口">
        <MenuItem.Icon>
            <ui:SymbolIcon Symbol="Window24" Width="15"/>
        </MenuItem.Icon>
    </MenuItem>

    <Separator/>

    <MenuItem Header="退出程序"
              Foreground="{StaticResource LessAsr.Brush.Error}"
              Click="OnExitApplicationClick"
              AutomationProperties.Name="退出程序">
        <MenuItem.Icon>
            <ui:SymbolIcon Symbol="Power24" Width="15"/>
        </MenuItem.Icon>
    </MenuItem>
</ContextMenu>
