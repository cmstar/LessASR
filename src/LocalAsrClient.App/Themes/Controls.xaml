<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="LessAsr.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LessAsr.Brush.CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="LessAsr.ButtonBase" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.58"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LessAsr.NavButton" TargetType="Button" BasedOn="{StaticResource LessAsr.ButtonBase}">
        <Setter Property="Height" Value="42"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource LessAsr.Brush.TextSecondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.CardBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource LessAsr.Brush.TextPrimary}"/>
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.CardBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource LessAsr.Brush.TextPrimary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Accent}"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LessAsr.PrimaryButton" TargetType="Button" BasedOn="{StaticResource LessAsr.ButtonBase}">
        <Setter Property="Background" Value="{StaticResource LessAsr.Brush.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.AccentHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.AccentHover}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.AccentPressed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.AccentPressed}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.Border}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource LessAsr.Brush.TextTertiary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LessAsr.SecondaryButton" TargetType="Button" BasedOn="{StaticResource LessAsr.ButtonBase}">
        <Setter Property="Background" Value="{StaticResource LessAsr.Brush.CardBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource LessAsr.Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Border}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.ControlHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.ControlPressed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.AccentPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.CardBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource LessAsr.Brush.TextTertiary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LessAsr.DestructiveButton" TargetType="Button" BasedOn="{StaticResource LessAsr.SecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource LessAsr.Brush.Error}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.ErrorSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Error}"/>
                <Setter Property="Foreground" Value="{StaticResource LessAsr.Brush.Error}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.ErrorSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Error}"/>
                <Setter Property="Foreground" Value="{StaticResource LessAsr.Brush.Error}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LessAsr.DestructivePrimaryButton" TargetType="Button" BasedOn="{StaticResource LessAsr.ButtonBase}">
        <Setter Property="Background" Value="{StaticResource LessAsr.Brush.Error}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Error}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.ErrorHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.ErrorHover}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.ErrorPressed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.ErrorPressed}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LessAsr.IconButton" TargetType="Button" BasedOn="{StaticResource LessAsr.SecondaryButton}">
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="LessAsr.DiagnosticButton" TargetType="Button" BasedOn="{StaticResource LessAsr.SecondaryButton}">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <Style x:Key="LessAsr.Keycap" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LessAsr.Brush.CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <Style x:Key="LessAsr.StatusBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LessAsr.Brush.AccentSoft}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <Style x:Key="LessAsr.Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource LessAsr.Brush.Border}"/>
    </Style>

    <Style x:Key="LessAsr.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LessAsr.Text.CardTitle}">
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="LessAsr.TextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Border}"/>
    </Style>

    <Style x:Key="LessAsr.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
</ResourceDictionary>
