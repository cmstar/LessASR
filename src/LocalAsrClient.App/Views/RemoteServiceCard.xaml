<UserControl x:Class="LocalAsrClient.App.Views.RemoteServiceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Border Style="{StaticResource LessAsr.Card}" Margin="0,0,0,12">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource LessAsr.Text.SectionTitle}"/>
                    <TextBlock Text="{Binding ProviderTypeText}" Style="{StaticResource LessAsr.Text.Caption}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Style="{StaticResource LessAsr.StatusBadge}"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="已启用"
                               Foreground="{StaticResource LessAsr.Brush.Accent}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Button Grid.Column="1"
                        Content="启用"
                        Click="Activate_Click"
                        VerticalAlignment="Top"
                        IsEnabled="{Binding CanActivate}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LessAsr.PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="配置名称" Style="{StaticResource LessAsr.FieldLabel}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource LessAsr.TextBox}"
                             IsEnabled="{Binding CanMutate}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="模型" Style="{StaticResource LessAsr.FieldLabel}"/>
                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource LessAsr.TextBox}"
                             IsEnabled="{Binding CanMutate}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="完整转写端点" Style="{StaticResource LessAsr.FieldLabel}" Margin="0,14,0,6"/>
            <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource LessAsr.TextBox}"
                     IsEnabled="{Binding CanMutate}"
                     ToolTip="例如 https://api.openai.com/v1/audio/transcriptions"/>
            <Border Background="{StaticResource LessAsr.Brush.WarningSoft}"
                    CornerRadius="8"
                    Padding="10,7"
                    Margin="0,8,0,0"
                    Visibility="{Binding IsHttpEndpoint, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding EndpointWarningText}"
                           Foreground="{StaticResource LessAsr.Brush.Warning}"
                           TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="代理服务器" Style="{StaticResource LessAsr.FieldLabel}" Margin="0,14,0,6"/>
            <Grid>
                <TextBox x:Name="ProxyUrlBox"
                         Text="{Binding ProxyUrl, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource LessAsr.TextBox}"
                         IsEnabled="{Binding CanMutate}"
                         ToolTip="支持 HTTP、HTTPS、SOCKS4、SOCKS4a 和 SOCKS5 代理"/>
                <TextBlock Text="可为空，例如 socks5://127.0.0.1:1080"
                           Foreground="{StaticResource LessAsr.Brush.TextTertiary}"
                           VerticalAlignment="Center"
                           Margin="11,0,0,0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=ProxyUrlBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock Text="支持 HTTP、HTTPS、SOCKS4、SOCKS4a 和 SOCKS5；当前不支持认证代理。"
                       Style="{StaticResource LessAsr.Text.Caption}"
                       Margin="0,6,0,0"/>

            <TextBlock Text="API Key" Style="{StaticResource LessAsr.FieldLabel}" Margin="0,14,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="ApiKeyBox"
                             Style="{StaticResource LessAsr.PasswordBox}"
                             IsEnabled="{Binding CanMutate}"
                             PasswordChanged="ApiKeyBox_PasswordChanged"
                             AutomationProperties.Name="API Key"/>
                <TextBlock x:Name="ApiKeyPlaceholder"
                           Text="{Binding ApiKeyPlaceholderText}"
                           Foreground="{StaticResource LessAsr.Brush.TextTertiary}"
                           VerticalAlignment="Center"
                           Margin="11,0,0,0"
                           IsHitTestVisible="False"/>
                <Button Grid.Column="1"
                        Content="清除已保存 Key"
                        Click="ClearApiKey_Click"
                        IsEnabled="{Binding CanClearApiKey}"
                        Style="{StaticResource LessAsr.SecondaryButton}"
                        Margin="8,0,0,0"/>
            </Grid>

            <CheckBox Content="启用词汇表"
                      IsChecked="{Binding UseVocabulary}"
                      IsEnabled="{Binding CanMutate}"
                      Margin="0,14,0,0"/>
            <TextBlock Text="启用后，当前词汇表会作为 prompt 随音频发送至 API。"
                       Style="{StaticResource LessAsr.Text.Caption}"
                       Margin="24,5,0,0"/>

            <TextBlock Text="测试会发送一段短静音音频，可能产生 API 费用，但不会切换当前服务。"
                       Style="{StaticResource LessAsr.Text.Caption}"
                       Margin="0,14,0,0"/>

            <Border Background="{StaticResource LessAsr.Brush.WarningSoft}"
                    CornerRadius="8"
                    Padding="10,7"
                    Margin="0,10,0,0"
                    Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="有未保存修改；切换模型会保留草稿，请保存或放弃修改后再测试或启用。"
                           Foreground="{StaticResource LessAsr.Brush.Warning}"
                           TextWrapping="Wrap"/>
            </Border>

            <WrapPanel Margin="0,10,0,0">
                <Button Content="保存" Click="Save_Click" IsEnabled="{Binding CanSave}" Style="{StaticResource LessAsr.PrimaryButton}" Margin="0,0,8,8"/>
                <Button Content="放弃修改"
                        Click="DiscardChanges_Click"
                        IsEnabled="{Binding CanDiscardChanges}"
                        Style="{StaticResource LessAsr.SecondaryButton}"
                        Margin="0,0,8,8"/>
                <Button Content="测试" Click="Test_Click" IsEnabled="{Binding CanTest}" Style="{StaticResource LessAsr.SecondaryButton}" Margin="0,0,8,8"/>
                <Button Content="删除" Click="Delete_Click" IsEnabled="{Binding CanDelete}" Style="{StaticResource LessAsr.DestructiveButton}" Margin="0,0,8,8"/>
            </WrapPanel>

            <TextBlock Text="{Binding LastMessage}"
                       Foreground="{StaticResource LessAsr.Brush.Success}"
                       TextWrapping="Wrap"
                       Visibility="{Binding LastMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
            <TextBlock Text="{Binding LastError}"
                       Foreground="{StaticResource LessAsr.Brush.Error}"
                       TextWrapping="Wrap"
                       Visibility="{Binding LastError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
        </StackPanel>
    </Border>
</UserControl>
