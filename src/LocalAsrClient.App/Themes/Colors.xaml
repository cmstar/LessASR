<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="LessAsr.Color.AppBackground">#F5F6F8</Color>
    <Color x:Key="LessAsr.Color.SidebarBackground">#F0F1F3</Color>
    <Color x:Key="LessAsr.Color.CardBackground">#FFFFFF</Color>
    <Color x:Key="LessAsr.Color.TextPrimary">#17181A</Color>
    <Color x:Key="LessAsr.Color.TextSecondary">#69707D</Color>
    <Color x:Key="LessAsr.Color.TextTertiary">#9299A5</Color>
    <Color x:Key="LessAsr.Color.Border">#E4E6EA</Color>
    <Color x:Key="LessAsr.Color.Accent">#4F6BED</Color>
    <Color x:Key="LessAsr.Color.AccentHover">#4059D4</Color>
    <Color x:Key="LessAsr.Color.AccentPressed">#354BC0</Color>
    <Color x:Key="LessAsr.Color.AccentSoft">#EEF1FF</Color>
    <Color x:Key="LessAsr.Color.ControlHover">#F7F8FA</Color>
    <Color x:Key="LessAsr.Color.ControlPressed">#EEF0F4</Color>
    <Color x:Key="LessAsr.Color.Success">#159A72</Color>
    <Color x:Key="LessAsr.Color.SuccessSoft">#EAF8F3</Color>
    <Color x:Key="LessAsr.Color.Warning">#B7791F</Color>
    <Color x:Key="LessAsr.Color.WarningSoft">#FFF7E8</Color>
    <Color x:Key="LessAsr.Color.Error">#C2413A</Color>
    <Color x:Key="LessAsr.Color.ErrorHover">#A93630</Color>
    <Color x:Key="LessAsr.Color.ErrorPressed">#8F2D29</Color>
    <Color x:Key="LessAsr.Color.ErrorSoft">#FFF0EF</Color>

    <SolidColorBrush x:Key="LessAsr.Brush.AppBackground" Color="{StaticResource LessAsr.Color.AppBackground}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.SidebarBackground" Color="{StaticResource LessAsr.Color.SidebarBackground}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.CardBackground" Color="{StaticResource LessAsr.Color.CardBackground}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.TextPrimary" Color="{StaticResource LessAsr.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.TextSecondary" Color="{StaticResource LessAsr.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.TextTertiary" Color="{StaticResource LessAsr.Color.TextTertiary}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.Border" Color="{StaticResource LessAsr.Color.Border}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.Accent" Color="{StaticResource LessAsr.Color.Accent}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.AccentHover" Color="{StaticResource LessAsr.Color.AccentHover}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.AccentPressed" Color="{StaticResource LessAsr.Color.AccentPressed}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.AccentSoft" Color="{StaticResource LessAsr.Color.AccentSoft}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.ControlHover" Color="{StaticResource LessAsr.Color.ControlHover}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.ControlPressed" Color="{StaticResource LessAsr.Color.ControlPressed}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.Success" Color="{StaticResource LessAsr.Color.Success}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.SuccessSoft" Color="{StaticResource LessAsr.Color.SuccessSoft}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.Warning" Color="{StaticResource LessAsr.Color.Warning}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.WarningSoft" Color="{StaticResource LessAsr.Color.WarningSoft}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.Error" Color="{StaticResource LessAsr.Color.Error}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.ErrorHover" Color="{StaticResource LessAsr.Color.ErrorHover}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.ErrorPressed" Color="{StaticResource LessAsr.Color.ErrorPressed}"/>
    <SolidColorBrush x:Key="LessAsr.Brush.ErrorSoft" Color="{StaticResource LessAsr.Color.ErrorSoft}"/>

    <!-- Keep WPF-UI toggle switches aligned with the LessASR accent palette. -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource LessAsr.Color.Accent}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource LessAsr.Color.AccentHover}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource LessAsr.Color.AccentPressed}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{StaticResource LessAsr.Color.Accent}" Opacity="0.45"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource LessAsr.Color.Accent}"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource LessAsr.Color.AccentHover}"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource LessAsr.Color.AccentPressed}"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="{StaticResource LessAsr.Color.Accent}" Opacity="0.45"/>
</ResourceDictionary>
