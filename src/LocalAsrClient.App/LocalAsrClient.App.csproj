<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Brand\LessASR.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalAsrClient.Core\LocalAsrClient.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Brand\*.ico" />
    <None Remove="Assets\Brand\LessASR.Brand.png" />
    <Resource Include="Assets\Brand\LessASR.ico" />
    <Resource Include="Assets\Brand\LessASR.Brand.png" />
    <EmbeddedResource Include="Assets\Brand\LessASR.Tray.Dark.ico"
                      LogicalName="LocalAsrClient.App.Assets.Brand.LessASR.Tray.Dark.ico" />
    <EmbeddedResource Include="Assets\Brand\LessASR.Tray.Light.ico"
                      LogicalName="LocalAsrClient.App.Assets.Brand.LessASR.Tray.Light.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" GeneratePathProperty="true" />
    <PackageReference Include="WPF-UI" Version="4.3.0" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE"
          Link="licenses\LessASR-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt"
          Link="licenses\THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\Apache-2.0.txt"
          Link="licenses\Apache-2.0.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgWPF-UI)\LICENSE.md"
          Link="licenses\WPF-UI-LICENSE.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgWPF-UI)\ThirdPartyNotices.txt"
          Link="licenses\WPF-UI-THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgNAudio)\license.txt"
          Link="licenses\NAudio-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateLicenseFiles" BeforeTargets="Build;Publish">
    <Error Condition="!Exists('..\..\LICENSE')"
           Text="LessASR LICENSE file is missing." />
    <Error Condition="!Exists('..\..\THIRD-PARTY-NOTICES.txt')"
           Text="LessASR third-party notices file is missing." />
    <Error Condition="!Exists('..\..\licenses\Apache-2.0.txt')"
           Text="Apache 2.0 license text is missing." />
    <Error Condition="!Exists('$(PkgWPF-UI)\LICENSE.md')"
           Text="WPF-UI license file is missing. Restore NuGet packages before building." />
    <Error Condition="!Exists('$(PkgWPF-UI)\ThirdPartyNotices.txt')"
           Text="WPF-UI third-party notices file is missing. Restore NuGet packages before building." />
    <Error Condition="!Exists('$(PkgNAudio)\license.txt')"
           Text="NAudio license file is missing. Restore NuGet packages before building." />
  </Target>
</Project>
