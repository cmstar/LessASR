<Window x:Class="LocalAsrClient.App.ContinuousDictation.ContinuousDictationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连续听写"
        Topmost="True"
        ShowInTaskbar="True"
        ShowActivated="True"
        Width="520"
        Height="640"
        MinWidth="400"
        MinHeight="400">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding HeaderText}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding BannerMessage}"
                   Foreground="#B45309"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding HasBanner, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="终止"
                    Command="{Binding TerminateCommand}"
                    MinWidth="72"
                    Margin="0,0,8,0"/>
            <Button Content="结束录制"
                    Command="{Binding EndRecordingCommand}"
                    MinWidth="88"
                    Margin="0,0,8,0"/>
            <Button Content="复制"
                    Command="{Binding CopyCommand}"
                    MinWidth="72"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Segments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="8"
                                CornerRadius="6"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                            <Setter Property="Background" Value="#FEF2F2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinHeight="72">
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="72"
                                         Padding="4"
                                         IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"/>
                                <TextBlock Text="{Binding Placeholder}"
                                           Foreground="#94A3B8"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="8,4"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding ShowPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
