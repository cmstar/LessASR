<Window x:Class="LocalAsrClient.App.Overlay.DictationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:overlay="clr-namespace:LocalAsrClient.App.Overlay"
        SizeToContent="WidthAndHeight"
        MaxWidth="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource LessAsr.FontFamily}">
    <Border BorderThickness="1"
            CornerRadius="16"
            Padding="14"
            MinWidth="{Binding OverlayMinWidth}"
            MinHeight="{Binding OverlayMinHeight}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource LessAsr.Brush.CardBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Border}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static overlay:OverlayState.LoadingModel}">
                        <Setter Property="Background" Value="{StaticResource LessAsr.Brush.WarningSoft}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Warning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static overlay:OverlayState.Injected}">
                        <Setter Property="Background" Value="{StaticResource LessAsr.Brush.SuccessSoft}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static overlay:OverlayState.Error}">
                        <Setter Property="Background" Value="{StaticResource LessAsr.Brush.ErrorSoft}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource LessAsr.Brush.Error}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid Visibility="{Binding ShowCompactLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource LessAsr.Brush.AccentSoft}" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="MicPulse24" Foreground="{StaticResource LessAsr.Brush.Accent}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="{Binding Message}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource LessAsr.Text.Caption}"
                               Foreground="{StaticResource LessAsr.Brush.Error}"
                               Margin="0,4,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource LessAsr.IconButton}"
                        Width="30" Height="30" MinWidth="30" MinHeight="30"
                        Focusable="False"
                        Command="{Binding CloseCommand}"
                        AutomationProperties.Name="关闭浮窗"
                        Visibility="{Binding ShowCloseButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="Dismiss24" Width="16"/>
                </Button>
            </Grid>

            <Grid Visibility="{Binding ShowCopyLayout, Converter={StaticResource BooleanToVisibilityConverter}}" MinWidth="300">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{Binding Message}" FontSize="15" FontWeight="SemiBold" Margin="0,4,42,0"/>
                    <Button Style="{StaticResource LessAsr.IconButton}"
                            Width="30" Height="30" MinWidth="30" MinHeight="30"
                            HorizontalAlignment="Right"
                            Focusable="False"
                            Command="{Binding CloseCommand}"
                            AutomationProperties.Name="关闭浮窗">
                        <ui:SymbolIcon Symbol="Dismiss24" Width="16"/>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource LessAsr.Brush.AppBackground}" BorderBrush="{StaticResource LessAsr.Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,10,0,0">
                    <TextBox Text="{Binding ResultText, Mode=OneWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             TextWrapping="Wrap"
                             MinHeight="58"
                             MaxHeight="{Binding ResultMaxHeight}"
                             IsReadOnly="True"
                             Focusable="False"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
                <Button Grid.Row="2"
                        Content="复制文本"
                        Style="{StaticResource LessAsr.PrimaryButton}"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0"
                        Focusable="False"
                        Command="{Binding CopyCommand}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
