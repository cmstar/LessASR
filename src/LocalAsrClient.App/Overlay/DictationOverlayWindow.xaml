<Window x:Class="LocalAsrClient.App.Overlay.DictationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MaxWidth="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        ResizeMode="NoResize">
    <Border Background="{Binding PanelBackground}"
            BorderBrush="{Binding PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            MinWidth="{Binding OverlayMinWidth}"
            MinHeight="{Binding OverlayMinHeight}">
        <Grid>
            <Grid Visibility="{Binding ShowCompactLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Message}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{Binding MessageForeground}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="13"
                               Foreground="{Binding ErrorDetailForeground}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="×"
                        Width="28"
                        Height="28"
                        Padding="0"
                        FontSize="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,-10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#64748B"
                        Cursor="Hand"
                        Focusable="False"
                        Command="{Binding CloseCommand}"
                        ToolTip="关闭"
                        Visibility="{Binding ShowCloseButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
            <Grid Visibility="{Binding ShowCopyLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding Message}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,0"/>
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="×"
                        Width="28"
                        Height="28"
                        Padding="0"
                        FontSize="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-6,-10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#64748B"
                        Cursor="Hand"
                        Focusable="False"
                        Command="{Binding CloseCommand}"
                        ToolTip="关闭"
                        Visibility="{Binding ShowCloseButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding ResultText, Mode=OneWay}"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         MaxHeight="{Binding ResultMaxHeight}"
                         IsReadOnly="True"
                         Focusable="False"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,8,0,0"
                         Visibility="{Binding ShowResultText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Content="复制"
                        Width="88"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Focusable="False"
                        Command="{Binding CopyCommand}"
                        Visibility="{Binding ShowCopyButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
