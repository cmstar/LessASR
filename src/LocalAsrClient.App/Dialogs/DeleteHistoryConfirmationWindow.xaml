<ui:FluentWindow x:Class="LocalAsrClient.App.Dialogs.DeleteHistoryConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="删除历史记录"
        Icon="../Assets/Brand/LessASR.ico"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LessAsr.Brush.AppBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="删除历史记录"/>

        <Border Grid.Row="1"
                Style="{StaticResource LessAsr.Card}"
                Margin="12,4,12,12"
                Padding="20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="{StaticResource LessAsr.Brush.ErrorSoft}"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Delete24"
                                       Width="22"
                                       Foreground="{StaticResource LessAsr.Brush.Error}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="确定删除这条历史记录？"
                                   Style="{StaticResource LessAsr.Text.SectionTitle}"/>
                        <TextBlock Text="删除后将无法恢复，使用统计不会受到影响。"
                                   Style="{StaticResource LessAsr.Text.Secondary}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource LessAsr.Brush.AppBackground}"
                        BorderBrush="{StaticResource LessAsr.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,18,0,0">
                    <TextBlock x:Name="HistoryPreview"
                               Style="{StaticResource LessAsr.Text.Body}"
                               MaxHeight="66"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="取消"
                            Width="92"
                            Style="{StaticResource LessAsr.SecondaryButton}"
                            IsCancel="True"
                            IsDefault="True"
                            AutomationProperties.Name="取消删除"/>
                    <Button Content="删除"
                            Width="92"
                            Margin="10,0,0,0"
                            Style="{StaticResource LessAsr.DestructivePrimaryButton}"
                            Click="OnDeleteClicked"
                            AutomationProperties.Name="确认删除历史记录"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
