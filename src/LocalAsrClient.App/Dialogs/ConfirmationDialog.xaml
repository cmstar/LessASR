<ui:FluentWindow x:Class="LocalAsrClient.App.Dialogs.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        Icon="../Assets/Brand/LessASR.ico"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LessAsr.Brush.AppBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{Binding Title}"/>

        <Border Grid.Row="1"
                Style="{StaticResource LessAsr.Card}"
                Margin="12,4,12,12"
                Padding="20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconContainer"
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon x:Name="ConfirmationIcon" Width="22"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{Binding Heading}"
                                   Style="{StaticResource LessAsr.Text.SectionTitle}"/>
                        <TextBlock Text="{Binding Message}"
                                   Style="{StaticResource LessAsr.Text.Secondary}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource LessAsr.Brush.AppBackground}"
                        BorderBrush="{StaticResource LessAsr.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,18,0,0"
                        Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding DisplayedPreview}"
                               Style="{StaticResource LessAsr.Text.Body}"
                               MaxHeight="66"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="{Binding CancelText}"
                            MinWidth="92"
                            Style="{StaticResource LessAsr.SecondaryButton}"
                            IsCancel="True"
                            IsDefault="{Binding IsCancelDefault}"
                            AutomationProperties.Name="{Binding CancelText}"/>
                    <Button x:Name="ConfirmButton"
                            Content="{Binding ConfirmText}"
                            MinWidth="92"
                            Margin="10,0,0,0"
                            IsDefault="{Binding IsConfirmDefault}"
                            Click="OnConfirmClicked"
                            AutomationProperties.Name="{Binding ConfirmText}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
