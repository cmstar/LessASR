<ui:FluentWindow x:Class="LocalAsrClient.App.Dialogs.VocabularyNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="新建词汇表"
        Icon="../Assets/Brand/LessASR.ico"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LessAsr.Brush.AppBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="新建词汇表"/>

        <Border Grid.Row="1"
                Style="{StaticResource LessAsr.Card}"
                Margin="12,4,12,12"
                Padding="20">
            <StackPanel>
                <TextBlock Text="词汇表名称"
                           Style="{StaticResource LessAsr.Text.SectionTitle}"/>
                <TextBlock Text="使用能够代表工作场景的名称，例如“编程开发”或“医疗记录”。"
                           Style="{StaticResource LessAsr.Text.Secondary}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,16"/>
                <TextBox x:Name="NameTextBox"
                         Style="{StaticResource LessAsr.TextBox}"
                         TextChanged="OnNameTextChanged"
                         AutomationProperties.Name="词汇表名称"/>
                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource LessAsr.Brush.Error}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>
                <TextBlock Text="名称最多 30 个字符，且不能与已有词汇表重复。"
                           Style="{StaticResource LessAsr.Text.Caption}"
                           Margin="0,8,0,0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="取消"
                            Width="92"
                            Style="{StaticResource LessAsr.SecondaryButton}"
                            IsCancel="True"/>
                    <Button x:Name="CreateButton"
                            Content="创建"
                            Width="92"
                            Margin="10,0,0,0"
                            Style="{StaticResource LessAsr.PrimaryButton}"
                            IsEnabled="False"
                            IsDefault="True"
                            Click="OnCreateClicked"
                            AutomationProperties.Name="创建词汇表"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
